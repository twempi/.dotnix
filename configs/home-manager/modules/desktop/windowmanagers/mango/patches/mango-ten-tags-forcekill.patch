+// Convert n to a fixed-width binary string, clamped to the uint32 tag mask.
+void bin_str_9bits(char *buf, uint32_t n) {
+	int32_t bits = tagcount > 0 ? tagcount : 9;
+	if (bits < 1)
+		bits = 9;
+	if (bits > 32)
+		bits = 32;
+	for (int32_t i = bits - 1; i >= 0; i--) {
 		*buf++ = ((n >> i) & 1) ? '1' : '0';
 	}
-	*buf = '\0'; // 字符串结尾
+	*buf = '\0';
 }
 
