diff --git a/src/wayland.rs b/src/wayland.rs
index c4b785d..db590cc 100644
--- a/src/wayland.rs
+++ b/src/wayland.rs
@@ -207,6 +207,12 @@ impl WaylandApp {
             self.event_loop
                 .dispatch(None, &mut self.state)
                 .expect("failed to dispatch events");
