#!/usr/bin/env python3
import argparse
import re
import sys
import json

parser = argparse.ArgumentParser(
    description="Convert gowall color variants output into config.yaml theme format"
)
parser.add_argument("name", help="Theme name")
parser.add_argument("-r", "--reverse", action="store_true", help="Reverse color order")
args = parser.parse_args()

text = sys.stdin.read()

# Prefer only colors after the arrow, ignoring the original input color
if "->" in text:
    text = text.split("->", 1)[1]

colors = re.findall(r"#[0-9a-fA-F]{6}", text)

if args.reverse:
    colors = list(reversed(colors))

if not colors:
    print("No colors found.", file=sys.stderr)
    sys.exit(1)

print(f'  - name: {json.dumps(args.name)}')
print("    colors:")
for color in colors:
    print(f'      - "{color.lower()}"')
